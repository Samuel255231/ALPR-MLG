# Modèle de configuration du backend.
# Copiez ce fichier en ".env" (même dossier) et remplissez vos vraies valeurs.
# Ne mettez JAMAIS de vraies valeurs dans ce fichier : il est envoyé sur Git. Le ".env" ne l'est pas.

# --- Django ---
# Générez une clé avec : python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=changez-moi
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de données PostgreSQL ---
DB_NAME=alpr_mlg
DB_USER=postgres
DB_PASSWORD=votre-mot-de-passe
DB_HOST=localhost
DB_PORT=5432

# --- Frontend autorisé (CORS) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Modèle YOLO (détection des plaques) ---
# Chemin du fichier best.pt, relatif au dossier backend
MODEL_PATH=models/best.pt

# --- Premier administrateur (commande : python manage.py seed_users) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choisissez-un-mot-de-passe-solide
ADMIN_EMAIL=
